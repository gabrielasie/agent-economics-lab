# Streamlit secrets template. Copy this to .streamlit/secrets.toml (which is gitignored) for
# local live runs, or paste the same key into the Streamlit Community Cloud dashboard under
# Settings -> Secrets for the deployed app.
#
# WARNING: a key on a PUBLIC deployment means every visitor can spend it. For a shareable demo,
# prefer the keyless path: run `uv run aelab counterfactual` once locally and commit
# data/first_price_raw.json, so the deployed app replays it with no key at all.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"
